# Local .terraform directories (contains downloaded providers and modules)
**/.terraform/*

# .tfstate files (contains sensitive system data and resource mappings)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all variable files that may contain secrets or environment-specific values
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Ignore local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore explicit plan files (prevents accidental commits of plaintext plans)
*tfplan*
